FROM python:3.12-slim

LABEL maintainer="sydgep"
LABEL description="This container extracts and converts structured files (CSV, JSON, Excel, Parquet, TXT) into Parquet. Supports column selection, gzip/zip compression."

ENV PYTHONUNBUFFERED=1

RUN pip install --no-cache-dir pandas pyarrow openpyxl

WORKDIR /app
COPY file_extraction.py /app/file_extraction.py

ENTRYPOINT ["python", "file_extraction.py"]

